---
/** Footer from the original Wix site: copyright, back-to-top, privacy policy. */
interface Props {
	/** Translucent bar over the page background (home page). */
	overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<footer class:list={["gm-footer", { "gm-footer--overlay": overlay }]}>
	<p>&copy; {new Date().getFullYear()} by Goat Mountain Enterprises, LLC</p>
	<a href="#top" class="gm-top" aria-label="Back to top">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
	</a>
	<a href="/privacy-policy">Privacy Policy</a>
</footer>

<style>
	.gm-footer {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: clamp(16px, 6vw, 72px);
		min-height: 56px;
		padding: 0 16px;
		border-top: 1px solid rgba(14, 46, 71, 0.15);
		font-size: 0.875rem;
		color: var(--color-text);
		background: var(--color-bg);
	}

	.gm-footer--overlay {
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(2px);
	}

	.gm-footer p {
		justify-self: end;
		margin: 0;
	}

	.gm-footer > a:last-child {
		justify-self: start;
		color: inherit;
	}

	.gm-top {
		display: grid;
		place-items: center;
		width: 48px;
		height: 56px;
		background: #0e2e47;
		color: #fff;
	}

	@media (max-width: 600px) {
		.gm-footer {
			grid-template-columns: 1fr auto;
			padding: 12px 16px;
			row-gap: 8px;
		}
		.gm-footer p {
			justify-self: start;
			grid-column: 1;
		}
		.gm-top {
			grid-row: 1 / span 2;
			grid-column: 2;
		}
		.gm-footer > a:last-child {
			grid-column: 1;
		}
	}
</style>
